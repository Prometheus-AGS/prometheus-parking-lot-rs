{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parking Lot Queue Example",
  "version": "0.1.0",
  "identifier": "ai.prometheusags.parkinglot.example",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Parking Lot Queue Example",
        "width": 720,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
