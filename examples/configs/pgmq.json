{
  "backends": {
    "events": {
      "type": "pgmq",
      "url": "postgres://parking_lot@localhost:5432/parking_lot",
      "queue_name": "events",
      "max_depth": 10000,
      "lease_secs": 30,
      "max_attempts": 5,
      "listen": true,
      "prepare": true
    }
  },
  "pools": {
    "llm_inference": {
      "max_units": 20,
      "max_queue_depth": 1000,
      "default_timeout_secs": 60,
      "queue": "in_memory",
      "mailbox": "in_memory"
    }
  }
}
